---
import IconGlobe from "@/assets/icons/IconGlobe.svg";
import { LOCALE_PREFERENCE_KEY } from "@/i18n/localePreference";
import { getLocale, localePathFromPathname } from "@/i18n/routing";
import type { Locale } from "@/i18n/ui";

const currentLocale = getLocale(Astro.currentLocale);
const alternateLocale: Locale = currentLocale === "en" ? "zh" : "en";
const alternatePath = localePathFromPathname(alternateLocale, Astro.url.pathname);
const alternateLabel = alternateLocale === "en" ? "English" : "中文";
---

<a
  href={alternatePath}
  class="rounded-md p-2 text-gray-600 transition-colors hover:bg-secondary hover:text-gray-900 focus:outline-none"
  aria-label={`Switch to ${alternateLabel}`}
  title={`Switch to ${alternateLabel}`}
  onclick={`localStorage.setItem('${LOCALE_PREFERENCE_KEY}','${alternateLocale}')`}
>
  <IconGlobe class="h-5 w-5" />
  <span class="sr-only">{alternateLabel}</span>
</a>
