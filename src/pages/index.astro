---
import { getCollection } from "astro:content";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hr from "@/components/Hr.astro";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import { SITE, SOCIALS } from "@/config";
import { getLocale, localePath } from "@/i18n/routing";
import { t } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPerson, getWebSite } from "@/utils/pageMetadata";

const locale = getLocale(Astro.currentLocale);

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const posts2025AndLater = sortedPosts.filter(({ data }) => data.pubDatetime.getFullYear() >= 2025);
const featuredPosts = posts2025AndLater.filter(({ data }) => data.featured);
const recentPosts = posts2025AndLater.filter(({ data }) => !data.featured);
const websiteData = getWebSite({
  title: SITE.title,
  website: SITE.website,
  description: SITE.desc,
  author: SITE.author,
});
const personData = getPerson({
  author: SITE.author,
  website: SITE.website,
  description: SITE.desc,
  image: new URL(`/${SITE.ogImage}`, SITE.website).href,
  socialLinks: SOCIALS.filter(({ active, href }) => active && href).map(({ href }) => href),
});
---

<Layout description={SITE.desc}>
  <script type="application/ld+json" set:html={JSON.stringify(websiteData)} />
  <script type="application/ld+json" set:html={JSON.stringify(personData)} />
  <Header />
  <main id="main-content" data-layout="index" data-back-url={localePath(locale)}>
    <section id="hero" class="pt-6 pb-4">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href={localePath(locale, "about")} class="block mx-auto sm:mx-0 group">
          <img
            src="/chen-mi-avatar.jpg"
            alt="chenmi"
            class="w-40 h-40 rounded-full object-cover flex-shrink-0 transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
          />
        </a>
        <div class="flex-1 text-center sm:text-left">
          <div class="flex items-center gap-2 justify-center sm:justify-start">
            <h1 class="my-2 inline-block text-2xl font-bold sm:my-4 sm:text-3xl">
              {t(locale, "home.greeting")}
            </h1>
            <a
              target="_blank"
              href="/rss.xml"
              class="inline-block"
              aria-label={t(locale, "home.rssFeed")}
              title={t(locale, "home.rssFeed")}
            >
              <IconRss
                width={20}
                height={20}
                class="scale-125 stroke-accent stroke-3"
              />
              <span class="sr-only">{t(locale, "home.rssFeed")}</span>
            </a>
          </div>
          <p>
            {t(locale, "home.bio")}
          </p>
          {
            // only display if at least one social link is enabled
            SOCIALS.filter((social) => social.active).length > 0 && (
              <div class="mt-4 flex flex-row items-center justify-center sm:justify-start">
                <Socials />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">{t(locale, "home.featured")}</h2>
            <ul>
              {featuredPosts.map((data) => (
                <Card variant="h3" {...data} showImage={false} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} showImage={false} />,
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={localePath(locale, "posts")}>
        {t(locale, "home.allPosts")}
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = document.querySelector<HTMLElement>("#main-content[data-layout='index']");
    if (indexLayout) {
      sessionStorage.setItem("backUrl", indexLayout.dataset.backUrl || "/");
    }
  });
</script>
